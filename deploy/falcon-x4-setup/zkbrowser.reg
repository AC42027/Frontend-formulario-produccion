Windows Registry Editor Version 5.00

; =====================================================
; Configuracion ZKbrowser CE7 - Falcon X4
; Inspecciones Goodyear Chile
; 
; IMPORTANTE: Importar este archivo en el dispositivo
; y luego ejecutar Persistent Registry > Persist
; =====================================================

[HKEY_LOCAL_MACHINE\Software\Datalogic\MobileComputer\LockedWeb]
"StartURL"="http://10.107.194.110/insp_pry/inspecciones_falcon/falcon.html"
"ErrorPage"="http://10.107.194.110/insp_pry/inspecciones_falcon/falcon.html"
"FullScreen"=dword:00000001
"EnableAddressBar"=dword:00000000
"EnableToolBar"=dword:00000000
"EnableStatusBar"=dword:00000001
"TimeoutValue"=dword:000927c0
